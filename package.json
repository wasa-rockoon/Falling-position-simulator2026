{
  "name": "falling-position-simulator2026",
  "version": "1.0.0",
  "private": true,
  "description": "WASA balloon landing prediction and launch planning tools",
  "scripts": {
    "build:data": "node scripts/build-marine-points.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test",
    "build:icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-pwa-icons.ps1",
    "build:ui-assets": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-ui-image-assets.ps1",
    "build:sw": "node scripts/build-service-worker.mjs",
    "build": "npm run build:data && npm run build:icons && npm run build:ui-assets && npm run build:sw"
  },
  "engines": {
    "node": ">=20"
  }
}
